# Kecualikan HANYA endpoint server-to-server / native API (WordPress, SSO Broadcast & OTA Exam Browser) dari HTML interstitial WAF
<FilesMatch "^(wp-broadcast|sso-broadcast|sso-stream|check-update)\.php$">
    <IfModule lsapi_module>
        php_value auto_prepend_file none
    </IfModule>
    <IfModule php7_module>
        php_value auto_prepend_file none
    </IfModule>
</FilesMatch>

<Files "sso-stream.php">
    <IfModule mod_env.c>
        SetEnv no-gzip 1
    </IfModule>
</Files>
