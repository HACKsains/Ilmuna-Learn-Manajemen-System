<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_splash"
    android:padding="28dp">

    <!-- Top Decorative Brand Section -->
    <LinearLayout
        android:id="@+id/layoutBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/layoutSplashActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <!-- App Icon Frame -->
        <FrameLayout
            android:id="@+id/frameSplashLogo"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="#FFFFFF"
            android:elevation="14dp"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imgSplashLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/app_logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:text="@string/splash_title"
            android:textColor="@color/white"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="#1AFFFFFF"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/splash_subtitle"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Actions Container -->
    <LinearLayout
        android:id="@+id/layoutSplashActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutBrand">

        <!-- Tombol Mulai Ujian -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartExam"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/lumina_gold"
            android:elevation="6dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.02"
            android:text="@string/btn_start_exam"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_secure"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <!-- Tombol Pengaturan Server -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfigServer"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/btn_server_settings"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
