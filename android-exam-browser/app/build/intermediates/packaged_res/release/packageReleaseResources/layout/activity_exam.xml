<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <!-- 1. TOP KIOSK HEADER (Seamless Dark Navy Status Bar) -->
    <LinearLayout
        android:id="@+id/kioskHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lumina_navy_dark"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="#FFFFFF"
            android:contentDescription="@string/app_name"
            android:padding="5dp"
            android:src="@drawable/app_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderAssessmentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:text="Asesmen Sumatif CBT"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvHeaderStudentInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Nama Siswa • Kelas"
                android:textColor="@color/lumina_sky"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Countdown Timer Pill -->
        <LinearLayout
            android:id="@+id/layoutTimerPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="#33FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Timer"
                android:src="@android:drawable/ic_menu_recent_history"
                app:tint="@color/lumina_gold" />

            <TextView
                android:id="@+id/tvCountdownTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-black"
                android:text="00:00:00"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tombol Buka Grid Nomor Soal -->
        <ImageButton
            android:id="@+id/btnOpenQuestionGrid"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Grid Soal"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@color/white" />

        <!-- Tombol Selesai Ujian -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinishExamHeader"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/status_danger"
            android:fontFamily="sans-serif-bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="Selesai"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/checkbox_on_background"
            app:iconGravity="textStart"
            app:iconSize="14dp"
            app:iconTint="@color/white" />
    </LinearLayout>

    <!-- Loading Bar -->
    <ProgressBar
        android:id="@+id/pbExamLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/lumina_gold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/kioskHeader" />

    <!-- 2. SCROLLABLE QUESTION TEXT PANEL -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuestionScrollable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@+id/cardFixedOptions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pbExamLoading">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Fixed Header inside Question Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvQuestionNumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="Soal No. 1 dari 10"
                        android:textColor="@color/lumina_navy"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvQuestionTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:fontFamily="sans-serif-black"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="PILIHAN GANDA"
                        android:textColor="@color/lumina_teal"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Progress Bar & Text -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressExamProgress"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:progress="0"
                    app:indicatorColor="@color/lumina_teal"
                    app:trackColor="#F1F5F9"
                    app:trackCornerRadius="3dp" />

                <TextView
                    android:id="@+id/tvExamProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="0 dari 10 soal terjawab (0%)"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="#E2E8F0" />
            </LinearLayout>

            <!-- Scrollable Question Body (Text + Stimulus + YouTube Video) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsvQuestionContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Gambar Stimulus (jika ada) -->
                    <ImageView
                        android:id="@+id/imgStimulus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="Stimulus Soal"
                        android:maxHeight="240dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <!-- Embedded YouTube Player In-App -->
                    <WebView
                        android:id="@+id/webYouTubePlayer"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone" />

                    <!-- Teks Pertanyaan Panjang -->
                    <TextView
                        android:id="@+id/tvQuestionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="5dp"
                        android:text="Memuat teks pertanyaan..."
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. FIXED OPTIONS / ESSAY INPUT PANEL (FLOATING ABOVE KEYBOARD LIKE WHATSAPP) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFixedOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvFixedOptionsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-black"
                android:text="Pilihan Jawaban:"
                android:textColor="@color/lumina_navy"
                android:textSize="12sp" />

            <!-- Scrollable Options for Multiple Choice -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsvOptionsWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constrainedHeight="true"
                android:maxHeight="200dp">

                <LinearLayout
                    android:id="@+id/layoutOptionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </androidx.core.widget.NestedScrollView>

            <!-- Container Essay / Uraian (Terpisah di panel bawah bergaya WhatsApp Input Bar) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEssayContainer"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tuliskan jawaban uraian Anda di sini..."
                android:visibility="gone"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/lumina_teal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEssayAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:maxLines="6"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. BOTTOM ACTION CONTROLS -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="0dp"
        app:cardElevation="12dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Tombol Sebelumnya -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevQuestion"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="Sebelumnya"
                android:textAllCaps="false"
                android:textColor="@color/lumina_navy"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_media_previous"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/lumina_navy"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1.5dp" />

            <!-- Tombol Ragu-ragu -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleRagu"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:text="Ragu"
                android:textAllCaps="false"
                android:textColor="@color/lumina_gold_dark"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_dialog_alert"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/lumina_gold_dark"
                app:strokeColor="@color/lumina_gold"
                app:strokeWidth="1.5dp" />

            <!-- Tombol Berikutnya -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextQuestion"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumina_navy"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="Berikutnya"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_media_next"
                app:iconGravity="textEnd"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/white" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
