<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_splash"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <!-- VERTICALLY CENTERED CONTAINER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:paddingVertical="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- CARD 1: DETAIL PESERTA UJIAN (2 KOLOM: FOTO & DATA SISWA) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStudentDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F8FAFC"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="18dp"
                            android:background="@color/lumina_teal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Detail Peserta Ujian"
                            android:textColor="@color/lumina_navy"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="#E2E8F0" />

                    <!-- 2 KOLOM LAYOUT -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- KOLOM KIRI: FOTO SISWA -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="80dp"
                            android:layout_height="96dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="3dp"
                            app:strokeColor="@color/lumina_teal"
                            app:strokeWidth="1.5dp">

                            <ImageView
                                android:id="@+id/imgStudentPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Foto Siswa"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_myplaces" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- KOLOM KANAN: DATA SISWA -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStudentName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Nama: - "
                                android:textColor="#0F172A"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvStudentNis"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="NIS / NISN: - "
                                android:textColor="#334155"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvStudentNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Nomor Peserta: - "
                                android:textColor="#334155"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvStudentClass"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Kelas: - "
                                android:textColor="#334155"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 2: DETAIL PAKET UJIAN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExamDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#F0F9FF"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#BAE6FD"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="18dp"
                            android:background="#0284C7" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Detail Paket Ujian"
                            android:textColor="#0369A1"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="#E0F2FE" />

                    <TextView
                        android:id="@+id/tvAssessmentTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:lineSpacingExtra="3dp"
                        android:text="Nama Asesmen: - "
                        android:textColor="#0F172A"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvExamDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Durasi Pengerjaan: - "
                        android:textColor="@color/lumina_gold_dark"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvAssessmentType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Tipe / Target KKTP: - "
                        android:textColor="#334155"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 3: PETUNJUK DAN ATURAN PENGERJAAN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFBEB"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#FDE68A"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="18dp"
                            android:background="@color/lumina_gold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Petunjuk &amp; Aturan Pengerjaan"
                            android:textColor="@color/lumina_gold_dark"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• Hitung mundur waktu HANYA dimulai saat menekan tombol di bawah.\n• Mode Kiosk: Dilarang membuka notifikasi, mini apps, atau keluar aplikasi.\n• Setiap jawaban pilihan ganda &amp; essay tersimpan otomatis ke server."
                        android:textColor="#78350F"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTTOM ACTIONS (MULAI UJIAN & KEMBALI) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartExamNow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/lumina_gold"
                android:elevation="6dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.02"
                android:text="Mulai Kerjakan Ujian Sekarang"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_media_play"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToLogin"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="← Kembali ke Halaman Login"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
